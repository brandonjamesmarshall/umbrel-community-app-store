# Copy this file to your Umbrel at EXACTLY this name and location:
#   ~/umbrel/app-data/brandonjamesmarshall-newt/.env
# It MUST be named ".env" (leading dot) and sit directly in the app folder
# — NOT in a data/ subfolder and NOT named newt.env. docker-compose loads
# it via the env_file directive in docker-compose.yml. Do NOT commit real
# values.
#
# Get NEWT_ID and NEWT_SECRET from your Pangolin site under "Newts".

PANGOLIN_ENDPOINT=https://app.pangolin.net
NEWT_ID=replace-with-your-newt-id
NEWT_SECRET=replace-with-your-newt-secret
LOG_LEVEL=INFO
