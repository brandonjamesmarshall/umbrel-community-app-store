# Copy to ~/umbrel/app-data/brandonjamesmarshall-newt/.env on your Umbrel
# and fill in the values. docker-compose auto-loads this file for
# variable interpolation. Do NOT commit your real values.
#
# Get NEWT_ID and NEWT_SECRET from your Pangolin site under "Newts".

PANGOLIN_ENDPOINT=https://app.pangolin.net
NEWT_ID=replace-with-your-newt-id
NEWT_SECRET=replace-with-your-newt-secret
LOG_LEVEL=INFO
