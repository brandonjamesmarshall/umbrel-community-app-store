# Buzz relay — user-specific config. Copy to ~/umbrel/app-data/brandonjamesmarshall-buzz/.env
# BEFORE installing the app (see the app description for the exact commands).
# Infra passwords (Postgres/Redis/MinIO) are NOT set here — they're derived
# from Umbrel's per-app APP_SEED inside docker-compose.yml.

# --- Identity (generate once, keep stable, covered by Umbrel backups) ---

# Your Nostr pubkey (64-char hex, NOT npub) — the relay owner in closed mode.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Relay's own keypair + git hook secret: `openssl rand -hex 32` for each.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_64_HEX

# --- Public URLs (your Pangolin resource domain) ---

BUZZ_DOMAIN=buzz.example.com
RELAY_URL=wss://buzz.example.com
BUZZ_MEDIA_BASE_URL=https://buzz.example.com/media
BUZZ_MEDIA_SERVER_DOMAIN=buzz.example.com
BUZZ_CORS_ORIGINS=https://buzz.example.com

# --- Relay policy (upstream production defaults: closed relay) ---

BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info
