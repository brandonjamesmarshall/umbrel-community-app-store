# REFERENCE ONLY — you do not create this file by hand anymore.
# The app's env-init service generates ~/umbrel/app-data/brandonjamesmarshall-buzz/.env
# on first start (secrets auto-minted, mode 600). You edit exactly two things
# afterwards — see README.md in this folder. Layout of the generated file:

RELAY_OWNER_PUBKEY=CHANGE_ME_YOUR_PUBKEY_64_HEX

BUZZ_RELAY_PRIVATE_KEY=<auto-generated, leave alone>
BUZZ_GIT_HOOK_HMAC_SECRET=<auto-generated, leave alone>

BUZZ_DOMAIN=CHANGE_ME.example.com
RELAY_URL=wss://CHANGE_ME.example.com
BUZZ_MEDIA_BASE_URL=https://CHANGE_ME.example.com/media
BUZZ_MEDIA_SERVER_DOMAIN=CHANGE_ME.example.com
BUZZ_CORS_ORIGINS=https://CHANGE_ME.example.com

# (Closed-relay policy — BUZZ_REQUIRE_AUTH_TOKEN / BUZZ_REQUIRE_RELAY_MEMBERSHIP /
# BUZZ_ALLOW_NIP_OA_AUTH — is hardcoded in docker-compose.yml and intentionally
# NOT configurable here.)
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info
