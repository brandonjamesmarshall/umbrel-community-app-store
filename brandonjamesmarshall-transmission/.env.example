# Copy to ~/umbrel/app-data/brandonjamesmarshall-transmission/.env on your
# Umbrel BEFORE installing the app, and fill in the values. gluetun reads
# this file via the env_file directive in docker-compose.yml.
# Do NOT commit your real values.
#
# Generate a WireGuard keypair locally:
#   brew install wireguard-tools          # on Mac (or apt-get install -y wireguard-tools on Linux)
#   wg genkey | tee >(wg pubkey > pub.key) > priv.key
# Paste the PUBLIC key into your iVPN account area (https://www.ivpn.net/account)
# under WireGuard, and iVPN will return your assigned tunnel address.

VPN_SERVICE_PROVIDER=ivpn
VPN_TYPE=wireguard

# Your 44-char base64 private key (the value of `cat priv.key`)
WIREGUARD_PRIVATE_KEY=replace-with-your-private-key

# The address iVPN assigned (e.g. 172.28.135.212/32) — include the /32
WIREGUARD_ADDRESSES=replace-with-your-assigned-ip/32

# A P2P-friendly city. Zurich (CH), Amsterdam (NL), Bucharest (RO) are good.
# See iVPN's P2P-allowed list: https://www.ivpn.net/knowledgebase/general/which-vpn-servers-can-i-use-for-p2p-torrent-traffic/
SERVER_CITIES=Zurich

# Optional:
# SERVER_COUNTRIES=Switzerland
# LOG_LEVEL=debug
# DOT_PROVIDERS=cloudflare,quad9

# Note: Transmission's RPC username/password are set via the USER and PASS
# env vars in docker-compose.yml (defaults: umbrel / umbrelmedia, surfaced
# in umbrelOS's app card). Edit the compose to change them.

# --- MyAnonaMouse dynamic seedbox (optional) ---
# The mam-seedbox sidecar re-authorizes Transmission's iVPN exit IP on MAM
# every 30 min via the Dynamic Seedbox API, so seeding survives iVPN IP
# rotations (otherwise announces fail with "Unrecognized host/passkey").
# Create a DEDICATED dynamic-seedbox session at MAM -> Preferences -> Security
# ("Allow Dynamic Seedbox: Yes") and paste its mam_id here. Leave blank if you
# don't use MAM.
MAM_ID=
