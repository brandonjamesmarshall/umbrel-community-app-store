# Copy to ~/umbrel/app-data/brandonjamesmarshall-transmission/.env on your
# Umbrel and fill in the values. docker-compose auto-loads this for ${VAR}
# interpolation. Do NOT commit your real values.

# --- Synology NFS mount for the shared media library ---
NAS_HOST=192.168.X.Y

# --- gluetun / iVPN tunnel ---
# Get these from your iVPN account area:
#   https://www.ivpn.net/clientarea/  ->  WireGuard tab  ->  Add key
# The .conf file iVPN gives you contains both values.
VPN_SERVICE_PROVIDER=ivpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=replace-with-your-private-key
WIREGUARD_ADDRESSES=replace-with-your-assigned-ip/32

# Pick a city near you for low latency (or set SERVER_COUNTRIES instead).
SERVER_CITIES=Amsterdam
# SERVER_COUNTRIES=Netherlands

# Optional tuning
# VPN_LOG_LEVEL=debug
# DOT_PROVIDERS=cloudflare,quad9
