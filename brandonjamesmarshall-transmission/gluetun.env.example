# Copy this file to your Umbrel at:
#   ~/umbrel/app-data/brandonjamesmarshall-transmission/data/gluetun.env
# and replace the placeholder values. Do NOT commit your real values.
#
# Get WIREGUARD_PRIVATE_KEY and WIREGUARD_ADDRESSES from your iVPN account:
#   https://www.ivpn.net/clientarea/  ->  WireGuard tab  ->  Add key & download config
# The .conf file iVPN gives you contains both values.

VPN_SERVICE_PROVIDER=ivpn
VPN_TYPE=wireguard

# 32-byte base64 WireGuard private key
WIREGUARD_PRIVATE_KEY=replace-with-your-private-key

# Assigned client IP, with /32 suffix, e.g. 172.16.0.42/32
WIREGUARD_ADDRESSES=replace-with-your-assigned-ip/32

# Pick a city near you for low latency. List of valid values:
#   docker run --rm qmcgaw/gluetun:latest format-servers -ivpn -country=... -city
# Or omit and gluetun picks one.
SERVER_CITIES=Amsterdam

# Optional: set to DEBUG while troubleshooting.
LOG_LEVEL=INFO

# DNS over TLS via Cloudflare/Quad9 (gluetun default is fine — uncomment to override)
# DOT_PROVIDERS=cloudflare,quad9
