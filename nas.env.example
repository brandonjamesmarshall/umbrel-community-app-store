# Per-app NAS connection. Drop one of these (named exactly ".env") into the
# project dir of each media app on your Umbrel before installing:
#
#   ~/umbrel/app-data/brandonjamesmarshall-plex/.env
#   ~/umbrel/app-data/brandonjamesmarshall-sonarr/.env
#   ~/umbrel/app-data/brandonjamesmarshall-radarr/.env
#   ~/umbrel/app-data/brandonjamesmarshall-sabnzbd/.env
#   ~/umbrel/app-data/brandonjamesmarshall-transmission/.env
#
# Single-command setup on the Umbrel (replace the IP first):
#
#   for app in plex sonarr radarr sabnzbd transmission; do
#     sudo mkdir -p ~/umbrel/app-data/brandonjamesmarshall-$app
#     echo "NAS_HOST=192.168.X.Y" | sudo tee ~/umbrel/app-data/brandonjamesmarshall-$app/.env
#   done
#
# The compose files reference ${NAS_HOST} in their NFS volume's driver_opts.
# Docker substitutes this at "compose up" time from the .env in the project dir.
#
# The NAS export path "/volume3/Plex Media" is hard-coded in the compose files
# because it doesn't vary across installs. NAS_HOST is the only per-install
# value, kept here so it doesn't end up in the public repo.

NAS_HOST=192.168.X.Y
