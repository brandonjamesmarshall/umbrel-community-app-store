# Copy this file to your Umbrel at EXACTLY this name and location:
#   ~/umbrel/app-data/brandonjamesmarshall-github-runner/.env
# It MUST be named ".env" (leading dot) and sit directly in the app folder
# — NOT in a data/ subfolder and NOT named runner.env. docker-compose loads
# it via the env_file directive in docker-compose.yml. Do NOT commit real
# values. After saving, lock it down (it holds a PAT):
#   sudo chmod 600 ~/umbrel/app-data/brandonjamesmarshall-github-runner/.env
#
# ACCESS_TOKEN is a GitHub Personal Access Token. The startup script in
# docker-compose.yml exchanges it for a fresh short-lived registration
# token on every (re)registration — no manual token refresh, and the PAT
# itself is never sent to the runner registration endpoint.
#   Classic PAT scope needed for an org runner: admin:org
#   Fine-grained alternative: org permission "Self-hosted runners" (r/w)
#
# The app registers at the ORG level (covers all repos in the org). Repo
# scope isn't wired up — it would need different API paths + URL in the
# docker-compose.yml script.

ACCESS_TOKEN=replace-with-your-github-pat
ORG_NAME=Vibewatch-io
RUNNER_NAME=umbrel-home-runner
# Jobs target this runner with: runs-on: [self-hosted, umbrel]
LABELS=umbrel,x64
